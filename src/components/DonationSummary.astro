---
import { formatJpy, type MoneyLocale } from '../lib/money';

interface Props {
  locale: MoneyLocale;
  raised: number;
  goal: number;
  ctaLabel: string;
  ctaHref: string;
  lastUpdated?: string;
}

const { locale, raised, goal, ctaLabel, ctaHref, lastUpdated } = Astro.props;

const isJa = locale === 'ja';
const progress = goal > 0 ? Math.min(100, Math.max(0, (raised / goal) * 100)) : 0;
const percent = Math.round(progress);

const t = isJa
  ? {
      raised: '支援総額',
      goal: (v: string) => `目標 ${v}`,
      reached: (p: number) => `目標の${p}%を達成`,
      funded: '達成',
      updated: (d: string) => `更新日 ${d}`,
      aria: '寄付の進捗',
    }
  : {
      raised: 'raised',
      goal: (v: string) => `of ${v} goal`,
      reached: (p: number) => `${p}% of our fundraising goal`,
      funded: 'funded so far',
      updated: (d: string) => `Updated ${d}`,
      aria: 'Donation progress',
    };
---

<div class="summary" aria-label={t.aria}>
  <div class="summary-main">
    <p class="summary-raised">
      {isJa && <span class="summary-label">{t.raised}</span>}
      <strong>{formatJpy(raised, locale)}</strong>
      {!isJa && <span class="summary-label">{t.raised}</span>}
    </p>

    <div
      class="summary-track"
      role="progressbar"
      aria-valuenow={percent}
      aria-valuemin="0"
      aria-valuemax="100"
      aria-label={t.reached(percent)}
    >
      <span style={`width: ${progress}%`}></span>
    </div>

    <p class="summary-meta">
      <span>{t.reached(percent)}</span>
      <span>{t.goal(formatJpy(goal, locale))}</span>
    </p>
  </div>

  <div class="summary-side">
    <p class="summary-percent">{percent}<span>%</span></p>
    <p class="summary-funded">{t.funded}</p>
    <a class="btn btn-highlight btn-large summary-cta" href={ctaHref}>{ctaLabel}</a>
    {lastUpdated && <p class="summary-updated">{t.updated(lastUpdated)}</p>}
  </div>
</div>

<style>
  .summary {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: center;
    max-width: 960px;
    margin-inline: auto;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    background: var(--color-bg-base);
    border-radius: var(--border-radius-lg);
    box-shadow: var(--shadow-hover);
    text-align: left;
  }

  @media (min-width: 768px) {
    .summary {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 3rem;
    }
  }

  .summary-main {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    min-width: 0;
  }

  .summary-raised {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
  }

  .summary-raised strong {
    font-size: clamp(2rem, 1.2rem + 3.4vw, 3.25rem);
    line-height: 1.05;
    color: var(--color-text-heading);
    letter-spacing: -0.02em;
  }

  .summary-label {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text-muted);
  }

  /* 太さは Figma 相当。細いバーだと達成率が読み取りにくい。 */
  .summary-track {
    height: 1.5rem;
    overflow: hidden;
    border-radius: 999px;
    background: var(--color-bg-alt);
  }

  .summary-track span {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: linear-gradient(90deg, var(--color-primary) 0%, var(--color-highlight) 100%);
  }

  .summary-meta {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    margin: 0;
    font-size: 0.95rem;
    color: var(--color-text-muted);
  }

  .summary-side {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    text-align: center;
  }

  .summary-percent {
    margin: 0;
    font-size: clamp(3rem, 2rem + 5vw, 5rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--color-primary);
  }

  .summary-percent span {
    font-size: 0.45em;
    margin-left: 0.1em;
  }

  .summary-funded {
    margin: 0 0 0.75rem;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-text-muted);
  }

  .summary-cta {
    white-space: nowrap;
  }

  .summary-updated {
    margin: 0.5rem 0 0;
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }
</style>
