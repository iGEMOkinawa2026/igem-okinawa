---
/**
 * Support / Sponsors Page (EN)
 */
import { getCollection } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Support from '../../components/Support.astro';
import DonationSummary from '../../components/DonationSummary.astro';
import { withBase } from '../../lib/paths';
import { getSettings } from '../../lib/settings';
import EurAmount from '../../components/EurAmount.astro';
import FxNote from '../../components/FxNote.astro';

const sponsors = (await getCollection('sponsors')).sort(
  (a, b) => a.data.order - b.data.order,
);
const donationPdfPath = withBase('assets/donation/igem-okinawa-fundraising-guide-en.pdf');
const donation = getSettings().donation;
const donationLocale = donation.en;
const { fx, funding } = donation;
const oistDonation = donationLocale.oist.enabled && donationLocale.oist.url
  ? donationLocale.oist
  : null;
---

<PageLayout
  title="Support Us | iGEM Okinawa"
  description="Support iGEM Okinawa's mission. Learn about sponsorship opportunities and how to help."
  locale="en"
>
  <PageHero
    title="Support Us"
    subtitle="Your support directly funds our lab equipment, project development, and competition entry."
    breadcrumbs={[{ label: 'Home', href: withBase('') }]}
  />

  <section class="section donation-summary-section">
    <div class="container">
      <DonationSummary
        locale="en"
        raised={donation.current_amount}
        goal={donation.goal_amount}
        ctaLabel="Donate via OIST"
        ctaHref="#donate"
        lastUpdated={donation.last_updated}
      />
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="support-info-grid">
        <div class="info-card">
          <h3>Participating Institutions</h3>
          <ul>
            <li>National Institute of Technology, Okinawa College (KOSEN)</li>
            <li>Okinawa Institute of Science and Technology Graduate University (OIST)</li>
            <li>University of the Ryukyus (Ryudai)</li>
            <li>Okinawa Christian School International</li>
          </ul>
        </div>
        <div class="info-card">
          <h3>Required Funding</h3>
          <ul>
            <li><strong>Team registration fee:</strong> <EurAmount amountEur={funding.registration_fee_eur} fx={fx} locale="en" /></li>
            <li><strong>Participation fee:</strong> <EurAmount amountEur={funding.participation_fee_eur} fx={fx} locale="en" /> per person</li>
            <li>
              <strong>Additional costs:</strong>
              {funding.other_costs.map((cost) => cost.label).join(', ')}
            </li>
          </ul>
          <FxNote fx={fx} locale="en" />
            </p>
          )}
        </div>
      </div>
    </div>
  </section>

  <section id="donate" class="section text-center donation-section">
    <div class="container">
      <h2>{donationLocale.title || 'Make a Donation'}</h2>
      {donationLocale.description && <p class="donation-lede">{donationLocale.description}</p>}

      <div class="payment-methods">
        <div class="payment-method-card payment-method-card-primary">
          <h4>OIST Donation</h4>
          <p class="payment-method-lede">
            Donations from outside Japan are handled through the official OIST donation form.
            Please name iGEM Okinawa in the designation field so the gift reaches our team.
          </p>
          {oistDonation?.note && <p class="payment-method-note">{oistDonation.note}</p>}
          {!oistDonation && <p class="payment-status">Detailed information is being prepared.</p>}
          {oistDonation && (
            <a href={oistDonation.url} target="_blank" rel="noopener noreferrer" class="btn btn-highlight btn-large">Donate via OIST</a>
          )}
          <p class="payment-method-note">
            Amounts are received in Japanese yen (JPY).
            {fx.converter_url && (
              <>
                {' '}
                <a href={fx.converter_url} target="_blank" rel="noopener noreferrer">Convert your currency</a>
              </>
            )}
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="section-header text-center">
        <h2>Donation Guide</h2>
        <p class="subtitle">View the fundraising guide directly on this page.</p>
      </div>
      <object class="donation-pdf-viewer" data={donationPdfPath} type="application/pdf">
        <iframe class="donation-pdf-viewer" src={donationPdfPath} title="iGEM Okinawa fundraising guide PDF"></iframe>
      </object>
      <p class="pdf-fallback">
        If the PDF does not appear, <a href={donationPdfPath}>open the donation guide PDF</a>.
      </p>
    </div>
  </section>

  <Support
    locale="en"
    title="Empower the Next Generation of Scientists"
    body="iGEM Okinawa's journey is made possible by the generosity of our sponsors and community. Your support directly funds our lab equipment, project development, and entry into the international iGEM competition."
    sponsorCtaHref="mailto:igemokinawa2026@gmail.com"
    sponsorCtaLabel="Become a Sponsor"
    deckHref="#"
    deckLabel="Sponsorship deck coming soon"
    sponsors={sponsors}
  />
</PageLayout>

<style>
  .support-info-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }
  @media (min-width: 768px) {
    .support-info-grid { grid-template-columns: 1fr 1fr; }
  }
  .info-card {
    background: var(--color-bg-base);
    padding: 2rem;
    border-radius: var(--border-radius-md);
    box-shadow: var(--shadow-sm);
  }
  .info-card h3 {
    color: var(--color-primary);
    margin-bottom: 1rem;
  }
  .info-card ul {
    list-style-type: disc;
    padding-left: 1.5rem;
  }
  .info-card li {
    margin-bottom: 0.5rem;
  }
  .donation-lede {
    max-width: 760px;
    margin: 0 auto 2rem;
  }
  /* Figma どおりヒーローに少し重ねる */
  .donation-summary-section {
    position: relative;
    z-index: 2;
    margin-top: -1.5rem;
    padding-top: 0;
    padding-bottom: clamp(2rem, 5vw, 3.5rem);
  }
  /* 決済手段は OIST のみなので、1枚を中央に置く */
  .payment-methods {
    display: flex;
    justify-content: center;
  }
  .payment-method-card {
    padding: 2.5rem 2rem;
    background: var(--color-bg-alt);
    border-radius: var(--border-radius-md);
    max-width: 640px;
    width: 100%;
  }
  .payment-method-lede,
  .payment-method-note {
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }
  .payment-method-lede {
    max-width: 48ch;
    margin-inline: auto;
  }
  .payment-method-note {
    margin-top: 1rem;
  }
  .donation-updated {
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }
  .payment-status {
    color: var(--color-text-muted);
  }
  .donation-pdf-viewer {
    width: 100%;
    min-height: 70vh;
    border: 1px solid rgba(0, 0, 0, 0.12);
    border-radius: var(--border-radius-md);
    background: var(--color-bg-base);
  }
  .pdf-fallback {
    margin-top: 1rem;
    text-align: center;
  }
</style>
