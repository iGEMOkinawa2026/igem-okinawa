---
/**
 * Support / Sponsors Page (EN)
 */
import { getCollection } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Support from '../../components/Support.astro';
import { withBase } from '../../lib/paths';

const sponsors = (await getCollection('sponsors')).sort(
  (a, b) => a.data.order - b.data.order,
);
const donationPdfPath = withBase('assets/donation/igem-okinawa-fundraising-guide.pdf');
---

<PageLayout
  title="Support Us | iGEM Okinawa"
  description="Support iGEM Okinawa's mission. Learn about sponsorship opportunities and how to help."
  locale="en"
>
  <PageHero
    title="Support Us"
    subtitle="Your support directly funds our lab equipment, project development, and competition entry."
    breadcrumbs={[{ label: 'Home', href: withBase('') }]}
  />

  <section class="section section-alt">
    <div class="container">
      <div class="support-info-grid">
        <div class="info-card">
          <h3>Participating Institutions</h3>
          <ul>
            <li>National Institute of Technology, Okinawa College (KOSEN)</li>
            <li>Okinawa Institute of Science and Technology Graduate University (OIST)</li>
            <li>University of the Ryukyus (Ryudai)</li>
            <li>Okinawa Christian School International</li>
          </ul>
        </div>
        <div class="info-card">
          <h3>Required Funding</h3>
          <ul>
            <li><strong>Team registration fee:</strong> €8,700 EUR</li>
            <li><strong>Participation fee:</strong> €575 EUR per person</li>
            <li><strong>Additional costs:</strong> travel, accommodation, lab materials, outreach activities</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section text-center">
    <div class="container">
      <h2>Make a Donation</h2>
      <p class="donation-lede">Donations are accepted through the official OIST donation form. Please use the donation guide below for details, and include iGEM Okinawa in the relevant message or designation field when applicable.</p>
      
      <div class="payment-methods">
        <div class="payment-method-card">
          <h4>Bank Transfer</h4>
          <p>You can donate directly to our official bank account.</p>
        </div>
        <div class="payment-method-card">
          <h4>Credit Card</h4>
          <p>We process credit card donations securely via OIST forms.</p>
        </div>
      </div>

      <div class="donation-actions">
        <a href="https://forms.oist.jp/form/donate-now" target="_blank" rel="noopener noreferrer" class="btn btn-highlight btn-large">Donate via OIST</a>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="section-header text-center">
        <h2>Donation Guide</h2>
        <p class="subtitle">View the fundraising guide directly on this page.</p>
      </div>
      <object class="donation-pdf-viewer" data={donationPdfPath} type="application/pdf">
        <iframe class="donation-pdf-viewer" src={donationPdfPath} title="iGEM Okinawa fundraising guide PDF"></iframe>
      </object>
      <p class="pdf-fallback">
        If the PDF does not appear, <a href={donationPdfPath}>open the donation guide PDF</a>.
      </p>
    </div>
  </section>

  <Support
    locale="en"
    title="Empower the Next Generation of Scientists"
    body="iGEM Okinawa's journey is made possible by the generosity of our sponsors and community. Your support directly funds our lab equipment, project development, and entry into the international iGEM competition."
    sponsorCtaHref="mailto:igemokinawa2026@gmail.com"
    sponsorCtaLabel="Become a Sponsor"
    deckHref="#"
    deckLabel="Sponsorship deck coming soon"
    sponsors={sponsors}
  />
</PageLayout>

<style>
  .support-info-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }
  @media (min-width: 768px) {
    .support-info-grid { grid-template-columns: 1fr 1fr; }
  }
  .info-card {
    background: var(--color-bg-base);
    padding: 2rem;
    border-radius: var(--border-radius-md);
    box-shadow: var(--shadow-sm);
  }
  .info-card h3 {
    color: var(--color-primary);
    margin-bottom: 1rem;
  }
  .info-card ul {
    list-style-type: disc;
    padding-left: 1.5rem;
  }
  .info-card li {
    margin-bottom: 0.5rem;
  }
  .donation-lede {
    max-width: 760px;
    margin: 0 auto 2rem;
  }
  .payment-methods {
    display: flex;
    justify-content: center;
    gap: 2rem;
    margin-bottom: 2rem;
    flex-wrap: wrap;
  }
  .payment-method-card {
    padding: 1.5rem;
    background: var(--color-bg-alt);
    border-radius: var(--border-radius-md);
    flex: 1;
    min-width: min(250px, 100%);
  }
  .donation-actions {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .donation-pdf-viewer {
    width: 100%;
    min-height: 70vh;
    border: 1px solid rgba(0, 0, 0, 0.12);
    border-radius: var(--border-radius-md);
    background: var(--color-bg-base);
  }
  .pdf-fallback {
    margin-top: 1rem;
    text-align: center;
  }
</style>
