---
/**
 * Support / Sponsors Page (JA)
 */
import { getCollection } from 'astro:content';
import PageLayout from '../../../layouts/PageLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import Support from '../../../components/Support.astro';
import DonationSummary from '../../../components/DonationSummary.astro';
import { withBase } from '../../../lib/paths';
import { getSettings } from '../../../lib/settings';
import EurAmount from '../../../components/EurAmount.astro';
import FxNote from '../../../components/FxNote.astro';

const sponsors = (await getCollection('sponsors')).sort(
  (a, b) => a.data.order - b.data.order,
);
const donationPdfPath = withBase('assets/donation/igem-okinawa-fundrasing-guide-ja.pdf');
const donation = getSettings().donation;
const donationLocale = donation.ja;
const { fx, funding } = donation;
const bankTransfer = donationLocale.bank_transfer;
const hasBankTransfer = Boolean(
  bankTransfer?.enabled &&
  bankTransfer.bank_name &&
  bankTransfer.branch_name &&
  bankTransfer.account_type &&
  bankTransfer.account_number &&
  bankTransfer.account_holder,
);
const oistDonation = donationLocale.oist.enabled && donationLocale.oist.url
  ? donationLocale.oist
  : null;
---

<PageLayout
  title="支援する | iGEM Okinawa"
  description="iGEM Okinawaのミッションを支援してください。スポンサーシップについてご案内します。"
  locale="ja"
>
  <PageHero
    title="支援する"
    subtitle="ご支援は、実験設備、プロジェクト開発、国際大会への参加に直結します。"
    breadcrumbs={[{ label: 'ホーム', href: withBase('ja/') }]}
  />

  <section class="section donation-summary-section">
    <div class="container">
      <DonationSummary
        locale="ja"
        raised={donation.current_amount}
        goal={donation.goal_amount}
        ctaLabel="銀行振込で寄付する"
        ctaHref="#bank-transfer"
        lastUpdated={donation.last_updated}
      />
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="support-info-grid">
        <div class="info-card">
          <h3>参加機関</h3>
          <ul>
            <li>沖縄工業高等専門学校（KOSEN）</li>
            <li>沖縄科学技術大学院大学（OIST）</li>
            <li>琉球大学</li>
            <li>Okinawa Christian School International</li>
          </ul>
        </div>
        <div class="info-card">
          <h3>必要な資金</h3>
          <ul>
            <li><strong>チーム登録料:</strong> <EurAmount amountEur={funding.registration_fee_eur} fx={fx} locale="ja" /></li>
            <li><strong>参加費:</strong> 1人あたり <EurAmount amountEur={funding.participation_fee_eur} fx={fx} locale="ja" /></li>
            <li>
              <strong>その他の費用:</strong>
              {funding.other_costs.map((cost) => cost.label_ja || cost.label).join('、')}
            </li>
          </ul>
          <FxNote fx={fx} locale="ja" />
        </div>
      </div>
    </div>
  </section>

  <section id="donate" class="section text-center donation-section">
    <div class="container">
      <h2>{donationLocale.title || '寄付によるご支援'}</h2>
      {donationLocale.description && <p class="donation-lede">{donationLocale.description}</p>}

      <div class="payment-methods">
        <div id="bank-transfer" class="payment-method">
          <p class="payment-method-eyebrow">おすすめ</p>
          <h4>銀行振込</h4>
          <p class="payment-method-lede">iGEM Okinawaの公式口座へ直接お振り込みいただけます。</p>
          {hasBankTransfer && bankTransfer ? (
            <dl class="bank-details">
              <div><dt>銀行名</dt><dd>{bankTransfer.bank_name}</dd></div>
              <div><dt>支店名</dt><dd>{bankTransfer.branch_name}</dd></div>
              <div><dt>口座種別</dt><dd>{bankTransfer.account_type}</dd></div>
              <div><dt>口座番号</dt><dd><code>{bankTransfer.account_number}</code></dd></div>
              <div><dt>口座名義</dt><dd>{bankTransfer.account_holder}</dd></div>
            </dl>
          ) : (
            <p class="payment-status">口座情報などの詳細は準備中です。</p>
          )}
          {hasBankTransfer && bankTransfer?.note && <p class="payment-method-note">{bankTransfer.note}</p>}
        </div>

        <div class="payment-method">
          <p class="payment-method-eyebrow payment-method-eyebrow-muted">クレジットカード</p>
          <h4>OIST寄付フォーム</h4>
          {oistDonation?.note && <p class="payment-method-note">{oistDonation.note}</p>}
          {!oistDonation && <p class="payment-status">寄付フォームなどの詳細は準備中です。</p>}
          {oistDonation && (
            <a href={oistDonation.url} target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-large">OIST寄付フォームへ</a>
          )}
        </div>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="section-header text-center">
        <h2>寄付案内PDF</h2>
        <p class="subtitle">ページ内でPDFをご確認いただけます。</p>
      </div>
      <object class="donation-pdf-viewer" data={donationPdfPath} type="application/pdf">
        <iframe class="donation-pdf-viewer" src={donationPdfPath} title="iGEM Okinawa 寄付案内PDF"></iframe>
      </object>
      <p class="pdf-fallback">
        PDFが表示されない場合は、<a href={donationPdfPath}>寄付案内PDFを開いて</a>ご確認ください。
      </p>
    </div>
  </section>

  <Support
    locale="ja"
    title="次世代の科学者を支える"
    body="iGEM Okinawaの挑戦は、スポンサーやコミュニティの皆さまのご支援によって実現しています。ご支援は、実験設備、プロジェクト開発、国際大会への参加などに直結します。"
    sponsorCtaHref="mailto:igemokinawa2026@gmail.com"
    sponsorCtaLabel="スポンサーになる"
    deckHref="#"
    deckLabel="スポンサー資料 (Coming soon)"
    sponsors={sponsors}
  />
</PageLayout>

<style>
  .support-info-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }
  @media (min-width: 768px) {
    .support-info-grid { grid-template-columns: 1fr 1fr; }
  }
  .info-card {
    background: var(--color-bg-base);
    padding: 2rem;
    border: 1px solid var(--color-primary-light);
  }
  .info-card h3 {
    color: var(--color-primary);
    margin-bottom: 1rem;
  }
  .info-card ul {
    list-style-type: disc;
    padding-left: 1.5rem;
  }
  .info-card li {
    margin-bottom: 0.5rem;
  }
  /* 説明文が未設定でも見出しと決済手段がくっつかないようにする */
  .donation-section h2 {
    margin-bottom: 2rem;
  }
  .donation-lede {
    max-width: 760px;
    margin: 0 auto 2rem;
  }
  /* Figma どおりヒーローに少し重ねる */
  .donation-summary-section {
    position: relative;
    z-index: 2;
    margin-top: -1.5rem;
    padding-top: 0;
    padding-bottom: clamp(2rem, 5vw, 3.5rem);
  }
  /* 枠や背景は付けず、余白と見出しだけで2つを分ける */
  .payment-methods {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    max-width: 880px;
    margin-inline: auto;
    text-align: center;
  }
  @media (min-width: 900px) {
    .payment-methods { grid-template-columns: 1fr 1fr; gap: 4rem; }
  }
  .payment-method {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }
  .payment-method h4 {
    margin: 0;
    font-size: 1.25rem;
  }
  .payment-method-lede,
  .payment-method-note {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    margin: 0;
    max-width: 34ch;
  }
  .payment-method .btn {
    margin-top: 1rem;
  }
  .payment-method-eyebrow {
    margin: 0;
    color: var(--color-highlight);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }
  .payment-method-eyebrow-muted {
    color: var(--color-text-muted);
  }
  .donation-updated {
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }
  .bank-details {
    margin: 1rem auto 0;
    width: 100%;
    max-width: 22rem;
    text-align: left;
  }
  .bank-details > div {
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: 0.75rem;
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--color-primary-light);
  }
  .bank-details dt {
    font-weight: 600;
  }
  .bank-details dd {
    overflow-wrap: anywhere;
  }
  .bank-details code {
    font-size: 1.1rem;
    user-select: all;
  }
  .payment-status {
    color: var(--color-text-muted);
  }
  .donation-pdf-viewer {
    width: 100%;
    min-height: 70vh;
    border: 1px solid rgba(0, 0, 0, 0.12);
    border-radius: var(--border-radius-md);
    background: var(--color-bg-base);
  }
  .pdf-fallback {
    margin-top: 1rem;
    text-align: center;
  }
</style>
