---
/**
 * Support / Sponsors Page (JA)
 */
import { getCollection } from 'astro:content';
import PageLayout from '../../../layouts/PageLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import Support from '../../../components/Support.astro';
import { withBase } from '../../../lib/paths';
import { getSettings } from '../../../lib/settings';

const sponsors = (await getCollection('sponsors')).sort(
  (a, b) => a.data.order - b.data.order,
);
const donationPdfPath = withBase('assets/donation/igem-okinawa-fundrasing-guide-ja.pdf');
const donation = getSettings().donation;
const donationLocale = donation.ja;
const progress = donation.goal_amount > 0
  ? Math.min(100, Math.max(0, (donation.current_amount / donation.goal_amount) * 100))
  : 0;
const formatAmount = (amount: number) =>
  new Intl.NumberFormat('ja-JP', { style: 'currency', currency: donation.currency }).format(amount);
const detailLinks = [
  { label: '資金の使い道', href: donationLocale.funding_plan_url },
  { label: 'お礼・返礼', href: donationLocale.returns_url },
  { label: '活動・進捗報告', href: donationLocale.updates_url },
].filter((link) => link.href);
const bankTransfer = donationLocale.bank_transfer;
const hasBankTransfer = Boolean(
  bankTransfer?.enabled &&
  bankTransfer.bank_name &&
  bankTransfer.branch_name &&
  bankTransfer.account_type &&
  bankTransfer.account_number &&
  bankTransfer.account_holder,
);
const oistDonation = donationLocale.oist.enabled && donationLocale.oist.url
  ? donationLocale.oist
  : null;
---

<PageLayout
  title="支援する | iGEM Okinawa"
  description="iGEM Okinawaのミッションを支援してください。スポンサーシップについてご案内します。"
  locale="ja"
>
  <PageHero
    title="支援する"
    subtitle="ご支援は、実験設備、プロジェクト開発、国際大会への参加に直結します。"
    breadcrumbs={[{ label: 'ホーム', href: withBase('ja/') }]}
  />

  <section class="section section-alt">
    <div class="container">
      <div class="support-info-grid">
        <div class="info-card">
          <h3>参加機関</h3>
          <ul>
            <li>沖縄工業高等専門学校（KOSEN）</li>
            <li>沖縄科学技術大学院大学（OIST）</li>
            <li>琉球大学</li>
            <li>Okinawa Christian School International</li>
          </ul>
        </div>
        <div class="info-card">
          <h3>必要な資金</h3>
          <ul>
            <li><strong>チーム登録料:</strong> €8,700 EUR</li>
            <li><strong>参加費:</strong> 1人あたり €575 EUR</li>
            <li><strong>その他の費用:</strong> 渡航費、宿泊費、実験機材費、アウトリーチ活動費</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section text-center donation-section">
    <div class="container">
      <h2>{donationLocale.title || '寄付によるご支援'}</h2>
      {donationLocale.description && <p class="donation-lede">{donationLocale.description}</p>}

      <div class="donation-progress" aria-label="寄付の進捗">
        <div class="donation-progress-values">
          <strong>{formatAmount(donation.current_amount)}</strong>
          <span>目標 {formatAmount(donation.goal_amount)}</span>
        </div>
        <div class="donation-progress-track" role="progressbar" aria-valuenow={Math.round(progress)} aria-valuemin="0" aria-valuemax="100" aria-label={`寄付目標の${Math.round(progress)}%を達成`}>
          <span style={`width: ${progress}%`}></span>
        </div>
        <p class="donation-progress-meta">達成率 {Math.round(progress)}%{donation.last_updated && ` · 更新日 ${donation.last_updated}`}</p>
      </div>

      {detailLinks.length > 0 && (
        <nav class="donation-context-links" aria-label="寄付に関する情報">
          {detailLinks.map((link) => (
            <a href={link.href} target="_blank" rel="noopener noreferrer">{link.label}</a>
          ))}
        </nav>
      )}

      <div class="payment-methods">
        {hasBankTransfer && bankTransfer && (
          <div class="payment-method-card payment-method-card-primary">
            <p class="payment-method-eyebrow">Primary</p>
            <h4>銀行振込</h4>
            <dl class="bank-details">
              <div><dt>銀行名</dt><dd>{bankTransfer.bank_name}</dd></div>
              <div><dt>支店名</dt><dd>{bankTransfer.branch_name}</dd></div>
              <div><dt>口座種別</dt><dd>{bankTransfer.account_type}</dd></div>
              <div><dt>口座番号</dt><dd><code>{bankTransfer.account_number}</code></dd></div>
              <div><dt>口座名義</dt><dd>{bankTransfer.account_holder}</dd></div>
            </dl>
            {bankTransfer.note && <p>{bankTransfer.note}</p>}
          </div>
        )}
        {oistDonation && (
          <div class="payment-method-card payment-method-card-secondary">
            <p class="payment-method-eyebrow">Secondary</p>
            <h4>OIST Donation</h4>
            {oistDonation.note && <p>{oistDonation.note}</p>}
            <a href={oistDonation.url} target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-large">OIST寄付フォームへ</a>
          </div>
        )}
      </div>

      {oistDonation && (
        <div class="donation-actions">
          <a href={oistDonation.url} target="_blank" rel="noopener noreferrer" class="btn btn-highlight btn-large">ご支援の手続きをする</a>
        </div>
      )}

      {!hasBankTransfer && !oistDonation && detailLinks.length === 0 && (
        <p class="donation-empty">寄付に関する情報は準備中です。</p>
      )}
      {donation.last_updated && (
        <p class="donation-updated">最終更新日: {donation.last_updated}</p>
      )}
      </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="section-header text-center">
        <h2>寄付案内PDF</h2>
        <p class="subtitle">ページ内でPDFをご確認いただけます。</p>
      </div>
      <object class="donation-pdf-viewer" data={donationPdfPath} type="application/pdf">
        <iframe class="donation-pdf-viewer" src={donationPdfPath} title="iGEM Okinawa 寄付案内PDF"></iframe>
      </object>
      <p class="pdf-fallback">
        PDFが表示されない場合は、<a href={donationPdfPath}>寄付案内PDFを開いて</a>ご確認ください。
      </p>
    </div>
  </section>

  <Support
    locale="ja"
    title="次世代の科学者を支える"
    body="iGEM Okinawaの挑戦は、スポンサーやコミュニティの皆さまのご支援によって実現しています。ご支援は、実験設備、プロジェクト開発、国際大会への参加などに直結します。"
    sponsorCtaHref="mailto:igemokinawa2026@gmail.com"
    sponsorCtaLabel="スポンサーになる"
    deckHref="#"
    deckLabel="スポンサー資料 (Coming soon)"
    sponsors={sponsors}
  />
</PageLayout>

<style>
  .support-info-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }
  @media (min-width: 768px) {
    .support-info-grid { grid-template-columns: 1fr 1fr; }
  }
  .info-card {
    background: var(--color-bg-base);
    padding: 2rem;
    border-radius: var(--border-radius-md);
    box-shadow: var(--shadow-sm);
  }
  .info-card h3 {
    color: var(--color-primary);
    margin-bottom: 1rem;
  }
  .info-card ul {
    list-style-type: disc;
    padding-left: 1.5rem;
  }
  .info-card li {
    margin-bottom: 0.5rem;
  }
  .donation-lede {
    max-width: 760px;
    margin: 0 auto 2rem;
  }
  .payment-methods {
    display: flex;
    justify-content: center;
    gap: 2rem;
    margin-bottom: 2rem;
    flex-wrap: wrap;
  }
  .payment-method-card {
    padding: 1.5rem;
    background: var(--color-bg-alt);
    border-radius: var(--border-radius-md);
    flex: 1;
    min-width: min(250px, 100%);
  }
  .payment-method-card-primary {
    border: 2px solid var(--color-highlight);
  }
  .payment-method-card-secondary {
    border: 2px solid var(--color-secondary);
  }
  .payment-method-eyebrow {
    color: var(--color-highlight);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .donation-progress {
    max-width: 760px;
    margin: 2rem auto;
    text-align: left;
  }
  .donation-progress-values,
  .donation-progress-meta {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }
  .donation-progress-track {
    height: 0.8rem;
    margin-top: 0.75rem;
    overflow: hidden;
    border-radius: 999px;
    background: var(--color-bg-alt);
  }
  .donation-progress-track span {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: var(--color-highlight);
  }
  .donation-progress-meta,
  .donation-updated {
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }
  .donation-context-links {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
    margin: 2rem auto;
  }
  .donation-context-links a {
    color: var(--color-secondary);
    font-weight: 600;
  }
  .bank-details {
    margin: 1.5rem 0;
    text-align: left;
  }
  .bank-details > div {
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: 0.75rem;
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--color-primary-light);
  }
  .bank-details dt {
    font-weight: 600;
  }
  .bank-details dd {
    overflow-wrap: anywhere;
  }
  .bank-details code {
    font-size: 1.1rem;
    user-select: all;
  }
  .donation-empty {
    margin: 2rem 0;
    color: var(--color-text-muted);
  }
  .donation-actions {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .donation-pdf-viewer {
    width: 100%;
    min-height: 70vh;
    border: 1px solid rgba(0, 0, 0, 0.12);
    border-radius: var(--border-radius-md);
    background: var(--color-bg-base);
  }
  .pdf-fallback {
    margin-top: 1rem;
    text-align: center;
  }
</style>
