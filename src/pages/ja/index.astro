---
/**
 * Portal Landing Page (JA)
 */
import YAML from 'yaml';

import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Mission from '../../components/Mission.astro';

import { siteCopy } from '../../data/siteCopy';
import { getMainNav } from '../../data/navigation';
import { withBase } from '../../lib/paths';
import { getEntry } from 'astro:content';
import { getSettings } from '../../lib/settings';

import socialRaw from '../../data/social.yaml?raw';

import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import iconWet      from '../../assets/icon-wet.png';
import iconDry      from '../../assets/icon-dry.png';
import iconHp       from '../../assets/icon-hp.png';
import iconFunding  from '../../assets/icon-funding.png';
import iconWiki     from '../../assets/icon-wiki.png';
import aboutWhat   from '../../assets/about-what.png';
import aboutWho    from '../../assets/about-who.png';
import aboutVision from '../../assets/about-vision.png';

/* about.cards[].icon と画像の対応 */
const aboutIcons: Record<string, ImageMetadata> = {
  what: aboutWhat,
  who: aboutWho,
  vision: aboutVision,
};

const settings = getSettings();
const currentYear = settings.current_year;
const currentProject = await getEntry('project', currentYear.toString());


const social = YAML.parse(socialRaw) as {
  links: { platform: string; url: string; shortLabel?: string }[];
};

const copy = siteCopy.ja;
const navItems = getMainNav('ja');

const footerLinks = navItems.map((item) => ({
  label: item.label,
  href: item.href,
}));


---

<BaseLayout title={`ポータル - ${copy.page.title}`} description="iGEM Okinawa チームポータルへようこそ" lang="ja">
  <Header
    siteTitle={copy.header.siteTitle}
    logoHref={withBase('ja/')}
    navItems={navItems}
    enHref={withBase('')}
    jaHref={withBase('ja/')}
    activeLang="ja"
    menuToggleLabel={copy.header.menuToggleLabel}
  />

  <main>
    <!-- Hero Section -->
    <section class="portal-hero">
      <div class="container text-center portal-hero-content">
        <div class="portal-hero-title-wrapper">
          <!-- left shisa -->
          <div class="portal-shisa portal-shisa-left" aria-hidden="true">
            <img src={withBase('shisa_left.PNG')} alt="" width="560" height="560" loading="eager" />
          </div>
          <h1 class="portal-hero-title">iGEM <strong>Okinawa</strong></h1>
          <!-- right shisa -->
          <div class="portal-shisa portal-shisa-right" aria-hidden="true">
            <img src={withBase('shisa_right.PNG')} alt="" width="560" height="560" loading="eager" />
          </div>
        </div>
        <p class="portal-hero-slogan">合成生物学で未来を創造する</p>
        <div class="portal-hero-actions">
          <a href="#about" class="btn btn-primary btn-large">私たちの使命</a>
        </div>
      </div>
    </section>

    <!-- About Section -->
    <Mission
      sectionTitle={copy.about.heading}
      subtitle={copy.about.subtitle}
      cards={copy.about.cards}
      icons={aboutIcons}
    />

    <!-- Project Preview -->
    <section class="section">
      <div class="container">
        {currentProject ? (
          <div class="project-preview-container">
            <div class="project-preview-text">
              <h2>最新の取り組み: {currentYear}</h2>
              <h3 style="font-size: 1.75rem; font-weight: bold; color: var(--color-text-heading); margin-bottom: 1rem;">{currentProject.data.title_ja || currentProject.data.title}</h3>
              <p>
                {currentProject.data.summary_ja || currentProject.data.summary}
              </p>
              <a href={withBase(`ja/archive/${currentYear}/`)} class="btn btn-primary">続きを読む</a>
            </div>
            <div class="project-preview-visual">
              {currentProject.data.image ? (
                <img src={withBase(currentProject.data.image)} alt={currentProject.data.title_ja || currentProject.data.title} style="width:100%; border-radius: var(--border-radius-md);" />
              ) : (
                <div class="dna-graphic-placeholder" style="background: var(--color-sub2, #6A9BD6); color: white; padding: 2rem; border-radius: var(--border-radius-md); text-align: center;">
                  🧬 {currentProject.data.title_ja || currentProject.data.title}
                </div>
              )}
            </div>
          </div>
        ) : (
          <div class="text-center">
            <p>プロジェクト情報がありません。</p>
          </div>
        )}
      </div>
    </section>

    <!-- Team Preview -->
    <!-- EDIT: チーム説明文・メンバー数はここを直接編集 -->
    <section class="section section-alt">
      <div class="container">
        <div class="section-header text-center">
          <h2>チームについて</h2>
          <p class="subtitle">
            OIST、沖縄高専、琉球大学の学生たちが集まり、活動しています。
          </p>
        </div>

        <div class="team-blocks">

          <div class="team-block">
            <div class="team-block-header">
              <span class="team-tag wet">Wet Lab</span>
              <h3>ウェットラボ</h3>
            </div>
            <Image src={iconWet} alt="" width={60} height={60} loading="lazy" class="team-block-icon" />
            <p>すべての実験業務（ファージの単離、タンパク質工学、クローニング、およびAIが予測した変異体の実験室での検証）を担当します。</p>
          </div>

          <div class="team-block">
            <div class="team-block-header">
              <span class="team-tag dry">Dry Lab</span>
              <h3>ドライラボ</h3>
            </div>
            <Image src={iconDry} alt="" width={60} height={60} loading="lazy" class="team-block-icon" />
            <p>低pH耐性ファージタンパク質変異体の予測を行うAIベースのパイプラインを構築・運用する。計算モデリングおよびデータ分析を担当する。</p>
          </div>

          <div class="team-block">
            <div class="team-block-header">
              <span class="team-tag hp">Human Practice</span>
              <h3>ヒューマンプラクティス</h3>
            </div>
            <Image src={iconHp} alt="" width={60} height={60} loading="lazy" class="team-block-icon" />
            <p>私たちの科学を社会と結びつける――地元の農家、医療従事者、地域社会と連携し、私たちの活動が真のニーズに応えるよう努めています。</p>
          </div>

          <div class="team-block">
            <div class="team-block-header">
              <span class="team-tag funding">Funding</span>
              <h3>ファンディング</h3>
            </div>
            <Image src={iconFunding} alt="" width={60} height={60} loading="lazy" class="team-block-icon" />
            <p>研究活動および国際大会への参加を維持するため、スポンサー開拓、寄付キャンペーン、および財務計画の管理を行っています。</p>
          </div>

          <div class="team-block">
            <div class="team-block-header">
              <span class="team-tag wiki">Wiki / Video</span>
              <h3>Wiki / Video</h3>
            </div>
            <Image src={iconWiki} alt="" width={60} height={60} loading="lazy" class="team-block-icon" />
            <p>iGEM Wiki、プロモーション動画、そしてこのウェブサイトを通じて、私たちの研究成果を記録・発信し、世界中の人々が私たちの活動にアクセスできるようにしています。</p>
          </div>

        </div>

        <div class="text-center" style="margin-top: 3rem;">
          <a href={withBase('ja/about/')} class="btn btn-primary">チーム全員のご紹介</a>
        </div>
      </div>
    </section>

    <!-- Support / Donation CTA Section -->
    <section class="section support-cta">
      <div class="container text-center">
        <div class="support-cta-inner">
          <p class="support-cta-eyebrow">ご支援のお願い</p>
          <h2 class="support-cta-heading">Paris 2026への挑戦をサポートしてください</h2>
          <p class="support-cta-body">
            iGEM Okinawaの活動は、学生の情熱と皆様からのご支援によって成り立っています。
            いただいた寄付は、実験機材の調達や大会への渡航費、そして次世代の沖縄の科学振興に活用されます。
            <br/><br/>
            スポンサーシップの詳細、寄付方法、ご支援の使途については、サポートページをご覧ください。
          </p>
          <a href={withBase('ja/support/')} class="btn btn-highlight btn-large">iGEM Okinawa を支援する →</a>
        </div>
      </div>
    </section>

  </main>

  <Footer
    brandTitle={copy.footer.brandTitle}
    brandTagline={copy.footer.brandTagline}
    exploreHeading={copy.footer.exploreHeading}
    exploreLinks={footerLinks}
    connectHeading={copy.footer.connectHeading}
    copyrightLine={copy.footer.copyrightLine}
    privacyHref={copy.footer.privacyHref}
    privacyLabel={copy.footer.privacyLabel}
    termsHref={copy.footer.termsHref}
    termsLabel={copy.footer.termsLabel}
    socialLinks={social.links}
  />
</BaseLayout>

<style>
  .portal-hero {
    padding: 8rem 1rem;
    background: linear-gradient(135deg, var(--color-bg-alt) 0%, var(--color-bg-base) 100%);
    position: relative;
    overflow: hidden;
  }
  .portal-hero::before {
    content: '';
    position: absolute;
    top: -50%;
    right: -20%;
    width: 80%;
    height: 200%;
    background: radial-gradient(circle, rgba(63, 209, 199, 0.1) 0%, transparent 70%);
    border-radius: 50%;
    z-index: 0;
  }
  .portal-hero .container {
    position: relative;
    z-index: 1;
  }
  .portal-hero-title-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    gap: clamp(0.5rem, 2vw, 2rem);
    margin-bottom: 1rem;
  }
  .portal-shisa {
    flex-shrink: 0;
    width: clamp(120px, 30vw, 320px);
  }
  .portal-shisa img {
    width: 100%;
    height: auto;
    display: block;
  }
  @media (max-width: 480px) {
    .portal-shisa { width: clamp(80px, 24vw, 120px); }
  }
  .portal-hero-title {
    font-size: clamp(3rem, 2rem + 4vw, 5rem);
    color: var(--color-text-heading);
    margin-bottom: 0;
    letter-spacing: -1px;
    line-height: 1.1;
  }
  .portal-hero-title strong {
    color: var(--color-primary);
  }
  .portal-hero-slogan {
    font-size: 1.5rem;
    color: var(--color-text-muted);
    max-width: 600px;
    margin: 0 auto 3rem;
  }
  .project-preview-container {
    display: grid;
    grid-template-columns: 1fr;
    gap: 4rem;
    align-items: center;
    background: var(--color-bg-base);
    padding: 3rem;
    border-radius: var(--border-radius-lg);
    box-shadow: var(--shadow-sm);
    border: 1px solid rgba(0,0,0,0.03);
  }
  @media (min-width: 768px) {
    .project-preview-container {
      grid-template-columns: 1fr 1fr;
    }
  }
  .project-preview-text h2 {
    font-size: 2.5rem;
    color: var(--color-primary);
    margin-bottom: 1rem;
  }
  .project-preview-text p {
    font-size: 1.125rem;
    margin-bottom: 2rem;
    color: var(--color-text-main);
  }
  .team-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }
  @media (min-width: 768px) {
    .team-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1024px) {
    .team-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
    /* ---- Team blocks ---- */
  .team-blocks {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    margin-top: 2rem;
  }
  @media (min-width: 640px) {
    .team-blocks { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 1024px) {
    .team-blocks { grid-template-columns: repeat(3, 1fr); }
  }
  .team-block {
    position: relative;
    background: var(--color-bg-base);
    border: 1px solid rgba(0,0,0,0.06);
    border-radius: var(--border-radius-lg);
    padding: 1.75rem;
    padding-right: 5.5rem;
  }
  .team-block-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }
  .team-block-icon {
    position: absolute;
    top: 1.25rem;
    right: 1.25rem;
    width: 60px;
    height: 60px;
    object-fit: contain;
    margin: 0;
  }
  .team-block h3 {
    font-size: 1.125rem;
    color: var(--color-text-heading);
    margin: 0;
  }
  .team-tag {
    font-size: 0.7rem;
    font-weight: 700;
    padding: 0.2rem 0.6rem;
    border-radius: 9999px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    flex-shrink: 0;
  }
  .team-tag.wet      { background: #dbeafe; color: #1e40af; }
  .team-tag.dry      { background: #dcfce7; color: #166534; }
  .team-tag.hp       { background: #fef9c3; color: #854d0e; }
  .team-tag.funding  { background: #fce7f3; color: #9d174d; }
  .team-tag.wiki     { background: #ede9fe; color: #5b21b6; }

  /* ---- Project preview tag ---- */
  .project-preview-tag {
    display: inline-block;
    background: var(--color-primary);
    color: #fff;
    font-size: 0.8rem;
    font-weight: 700;
    padding: 0.2rem 0.75rem;
    border-radius: 9999px;
    margin-bottom: 1rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  /* ---- DNA graphic placeholder ---- */
  .dna-graphic-placeholder {
    background: var(--color-bg-alt);
    border-radius: var(--border-radius-lg);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2rem;
    min-height: 200px;
    color: var(--color-text-muted);
  }

  /* ---- Mission grid ---- */
  .mission-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    margin-top: 2rem;
  }
  @media (min-width: 768px) {
    .mission-grid { grid-template-columns: repeat(3, 1fr); }
  }
  .mission-card {
    background: linear-gradient(135deg, #FFFFFF 0%, #F0FBFC 100%);
    border-radius: var(--border-radius-lg);
    padding: 2rem;
    text-align: center;
    border: 1px solid rgba(92,207,230,0.15);
  }
  .mission-card .icon {
    font-size: 2rem;
    margin-bottom: 1rem;
  }
  .mission-card h3 {
    font-size: 1.125rem;
    color: var(--color-text-heading);
    margin-bottom: 0.75rem;
  }

  .support-cta {
  background: linear-gradient(135deg, var(--color-primary) 0%, #2fa198 100%);
  padding-block: clamp(3rem, 6vw, 6rem);
  }
  .support-cta-inner {
    max-width: 640px;
    margin-inline: auto;
  }
  .support-cta-eyebrow {
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.7);
    margin-bottom: 0.75rem;
  }
  .support-cta-heading {
    font-size: clamp(1.75rem, 2rem + 1vw, 2.75rem);
    color: #fff;
    margin-bottom: 1rem;
  }
  .support-cta-body {
    font-size: 1.1rem;
    color: rgba(255,255,255,0.85);
    margin-bottom: 2rem;
    max-width: 56ch;
    margin-inline: auto;
  }
</style>
