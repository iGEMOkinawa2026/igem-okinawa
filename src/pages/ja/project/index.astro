---
/**
 * Project Page (JA)
 *
 * 本文と見た目は ProjectStory.astro に集約している（EN / JA で共通）。
 * 表示内容は src/content/project/{current_year}.md から読むため、
 * このページはデータの取得とヘッダー・フッターの組み立てだけを行う。
 */
import YAML from 'yaml';
import { getEntry } from 'astro:content';

import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import ProjectStory from '../../../components/ProjectStory.astro';

import { siteCopy } from '../../../data/siteCopy';
import { getMainNav } from '../../../data/navigation';
import { withBase } from '../../../lib/paths';
import { getSettings } from '../../../lib/settings';

import socialRaw from '../../../data/social.yaml?raw';

const social = YAML.parse(socialRaw) as {
  links: { platform: string; url: string; shortLabel?: string }[];
};

const copy = siteCopy.ja;
const navItems = getMainNav('ja');
const footerLinks = navItems.map((item) => ({ label: item.label, href: item.href }));

const currentYear = getSettings().current_year;
const currentProject = await getEntry('project', currentYear.toString());
const projectData = currentProject?.data;

/* 日本語が未入力なら英語へ落とす（docs/ai/coding-rules.md のローカライズ規約）。 */
const pageDescription =
  projectData?.summary_ja || projectData?.summary || copy.page.description;
---

<BaseLayout title={`プロジェクト ${currentYear} - ${copy.page.title}`} description={pageDescription} lang="ja">
  <Header
    siteTitle={copy.header.siteTitle}
    logoHref={withBase('ja/')}
    navItems={navItems}
    enHref={withBase('project/')}
    jaHref={withBase('ja/project/')}
    activeLang="ja"
    menuToggleLabel={copy.header.menuToggleLabel}
  />

  <ProjectStory locale="ja" year={currentYear} project={projectData} />

  <Footer
    brandTitle={copy.footer.brandTitle}
    brandTagline={copy.footer.brandTagline}
    exploreHeading={copy.footer.exploreHeading}
    exploreLinks={footerLinks}
    connectHeading={copy.footer.connectHeading}
    copyrightLine={copy.footer.copyrightLine}
    privacyHref={copy.footer.privacyHref}
    privacyLabel={copy.footer.privacyLabel}
    termsHref={copy.footer.termsHref}
    termsLabel={copy.footer.termsLabel}
    socialLinks={social.links}
  />
</BaseLayout>
