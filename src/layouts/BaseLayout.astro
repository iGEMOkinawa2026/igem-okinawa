---
import YAML from 'yaml';
import '../styles/global.css';
import socialRaw from '../data/social.yaml?raw';

interface Props {
  title: string;
  description: string;
  lang?: 'en' | 'ja';
  canonicalUrl?: string;
}

const { title, description, lang = 'en', canonicalUrl } = Astro.props;
const siteOrigin = 'https://igemokinawa2026.github.io';
const basePath = '/igem-okinawa/';
const homeUrl = `${siteOrigin}${basePath}`;
const normalizedPath = Astro.url.pathname.startsWith(basePath)
  ? Astro.url.pathname
  : `${basePath}${Astro.url.pathname.replace(/^\//, '')}`;
const currentUrl = canonicalUrl ?? new URL(normalizedPath, siteOrigin).toString();
const ogImageUrl = `${homeUrl}og-image.png`;
const social = YAML.parse(socialRaw) as {
  links?: { platform: string; url: string; shortLabel?: string }[];
};
const sameAs = social.links
  ?.map((link) => link.url)
  .filter((url) => url.startsWith('https://') || url.startsWith('http://'));
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'iGEM Okinawa 2026',
  url: homeUrl,
  description: 'Official website of iGEM Okinawa 2026.',
  ...(sameAs?.length ? { sameAs } : {}),
};
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={currentUrl} />
    <link rel="icon" type="image/png" href={`${import.meta.env.BASE_URL}logo.png`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Outfit:wght@400;600;800&display=swap"
      rel="stylesheet"
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={currentUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImageUrl} />
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
  </head>
  <body>
    <slot />
  </body>
</html>
